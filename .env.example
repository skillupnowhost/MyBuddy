# --- Database ---
POSTGRES_USER=mybuddy
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mybuddy
DATABASE_URL=postgresql+psycopg://mybuddy:change_me@db:5432/mybuddy

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM / Ollama ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBEDDING_MODEL=all-minilm

# --- RAG / documents ---
STORAGE_DIR=./data
MAX_UPLOAD_SIZE_BYTES=20971520
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150
RAG_TOP_K=4

# --- Code (RAG + editor) ---
OLLAMA_CODE_MODEL=qwen2.5-coder:1.5b
CODE_MAX_ZIP_SIZE_BYTES=26214400
CODE_MAX_EXTRACTED_SIZE_BYTES=104857600
CODE_MAX_FILES_PER_PROJECT=2000

# --- Vision (image/screenshot understanding) ---
OLLAMA_VISION_MODEL=moondream
MAX_IMAGE_SIZE_BYTES=10485760

# --- Sandbox (code execution, ADMIN-only — see backend/README for the security boundary) ---
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MAX_OUTPUT_BYTES=65536

# --- Admin ---
# Comma-separated emails auto-promoted to ADMIN on registration. Set before your first
# registration to bootstrap an admin account.
ADMIN_EMAILS=

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
